<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <permission android:name="com.bydcollector.collector.permission.RUNTIME"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.bydcollector.collector.permission.RUNTIME" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <queries>
        <package android:name="com.bydcollector.collector.ui" />
        <package android:name="com.bydhud.app" />
        <package android:name="com.byd.extend" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/collector_launcher_icon"
        android:label="${collectorLabel}"
        android:name="com.bydcollector.collector.BydCollectorApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@drawable/collector_launcher_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <provider
            android:name="com.bydcollector.collector.runtime.RuntimeEndpointProvider"
            android:authorities="com.bydcollector.collector.runtime"
            android:exported="true"
            android:permission="com.bydcollector.collector.permission.RUNTIME" />

        <service android:name="com.bydcollector.collector.runtime.RuntimeJobsService"
            android:exported="false" android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <activity
            android:name="com.bydcollector.collector.runtime.RuntimeLauncherActivity"
            android:excludeFromRecents="true"
            android:exported="false" />
        <activity-alias
            android:name="com.bydcollector.collector.MainActivity"
            android:targetActivity="com.bydcollector.collector.runtime.RuntimeLauncherActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name="com.bydcollector.collector.service.CollectorService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync|location" />

        <service
            android:name="com.bydcollector.collector.system.AutoStartRecoveryService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="com.bydcollector.collector.service.DatabaseMaintenanceService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="com.bydcollector.collector.service.TripCompressionService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="dataSync" />

        <service
            android:name="com.bydcollector.collector.system.CollectorNotificationListenerService"
            android:enabled="true"
            android:exported="true"
            android:label="${collectorLabel} lifecycle anchor"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <service
            android:name="com.bydcollector.collector.update.UpdateHintCoordinationService"
            android:exported="true"
            android:stopWithTask="false">
            <intent-filter>
                <action android:name="com.byd.apps.updatehint.COORDINATION" />
            </intent-filter>
            <meta-data android:name="com.byd.apps.updatehint.PROTOCOL_VERSION" android:value="1" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>

        <receiver
            android:name="com.bydcollector.collector.system.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="9900">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="com.bydcollector.collector.system.InternalAutoStartReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name="com.bydcollector.collector.system.KeepAliveRecoveryReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.bydcollector.collector.action.KEEP_ALIVE_RECOVERY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
